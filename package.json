{
  "name": "dream-project",
  "version": "0.0.0",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve dream-game",
    "start:sandbox": "ng serve shared-ui-sandbox",
    "build": "turbo run build",
    "test": "turbo run test",
    "api-extractor": "turbo run api-extractor",
    "format": "prettier --write .",
    "e2e": "turbo run e2e",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "init-game": "turbo run init-game",
    "generate-items": "turbo run generate-items",
    "verify-work": "bash .opencode/scripts/verify-work.sh",
    "deploy-work": "bash .opencode/scripts/deploy-work.sh --commit"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "21.2.8",
    "@angular/compiler": "21.2.8",
    "@angular/core": "21.2.8",
    "@angular/forms": "21.2.8",
    "@angular/platform-browser": "21.2.8",
    "@angular/router": "21.2.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.8",
    "@microsoft/api-extractor": "7.58.2",
    "@playwright/test": "1.59.1",
    "@types/node": "25.6.0",
    "firebase-tools": "15.14.0",
    "jsdom": "27.4.0",
    "prettier": "3.8.3",
    "turbo": "2.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
