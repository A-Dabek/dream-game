{
  "name": "dream-project",
  "version": "0.0.0",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve dream-game",
    "start:sandbox": "ng serve shared-ui-sandbox",
    "build": "turbo run build",
    "test": "turbo run test",
    "api-extractor": "turbo run api-extractor",
    "format": "prettier --write .",
    "e2e": "turbo run e2e",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "init-game": "turbo run init-game",
    "generate-items": "tsc -p projects/game-board/tsconfig.app.json && node out-tsc/game-board/game-board/random-item/generate-random-items.js",
    "verify-work": "bash .opencode/scripts/verify-work.sh",
    "deploy-work": "bash .opencode/scripts/deploy-work.sh --commit"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@microsoft/api-extractor": "^7.56.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "firebase-tools": "^15.8.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.7.4",
    "turbo": "^2.4.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
