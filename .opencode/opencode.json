{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "reasoning": {
          "id": "minimax/minimax-m2.7"
        },
        "cheap": {
          "id": "minimax/minimax-m2.7"
        },
        "small": {
          "id": "minimax/minimax-m2.7"
        },
        "backup2": {
          "id": "minimax/minimax-m2.5",
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "min_p": 0.01,
            "top_k": 40,
            "repeat_penalty": 1.0
          }
        },
        "backup": {
          "id": "moonshotai/kimi-k2.5",
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "min_p": 0.01,
            "top_k": 40
          }
        }
      }
    }
  },
  "command": {
    "develop": {
      "agent": "developer",
      "description": "Execute development plan from specification",
      "template": "Execute the implementation plan from $1"
    },
    "qa": {
      "agent": "qa",
      "description": "Validate and test implementation",
      "template": "Validate the implementation. Review these changed files:\n!`git diff --name-status`\n\nEnsure all acceptance criteria are met, tests are written and passing. User story: $1"
    },
    "refactor": {
      "agent": "refactoring",
      "description": "Clean up code after implementation",
      "template": "Refactor and clean up the code. Review these changed files:\n!`git diff --name-status`\n\nApply refactoring improvements while maintaining business logic."
    },
    "docs": {
      "agent": "documentation",
      "description": "Update documentation",
      "template": "Update documentation based on implementation. Review these changed files:\n!`git diff --name-status`\n\nUpdate relevant documentation files if needed."
    },
    "signoff": {
      "agent": "developer",
      "description": "Create a branch and deploy work",
      "template": "Create a feature branch based on current changes, unless it's already created, and run script .opencode/scripts/deploy-work.sh --commit <message>"
    }
  },
  "mcp": {
    "angular-cli": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@angular/cli", "mcp"]
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "C:\\Users\\asan_\\IdeaProjects\\serena\\.venv\\Scripts\\serena.exe",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "ide"
      ]
    }
  },
  "permission": {
    "bash": {
      "npm i*": "deny",
      "playwright test --update-snapshots": "deny",
      "npm run e2e:update": "deny"
    }
  },
  "agent": {
    "planner": {
      "description": "{file:./agents/planner.md}",
      "color": "#FF0000",
      "mode": "primary",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 30,
      "repeat_penalty": 1.0,
      "task": {
        "developer": "deny",
        "reviewer": "deny"
      },
      "tools": {
        "angular-cli": true,
        "serena": true
      },
      "permission": {
        "skill": {
          "*": "allow"
        },
        "edit": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        },
        "write": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        }
      }
    },
    "documentation": {
      "description": "{file:./agents/documentation.md}",
      "mode": "all",
      "color": "#0000FF",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 30,
      "repeat_penalty": 1.0,
      "tools": {
        "angular-cli": true,
        "serena": true
      },
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "developer": {
      "description": "{file:./agents/developer.md}",
      "mode": "all",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 30,
      "repeat_penalty": 1.0,
      "permission": {
        "skill": {
          "*": "allow"
        }
      },
      "tools": {
        "angular-cli": true,
        "serena": true
      }
    },
    "refactoring": {
      "description": "{file:./agents/refactoring.md}",
      "mode": "all",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 30,
      "repeat_penalty": 1.0,
      "tools": {
        "angular-cli": true,
        "serena": true
      }
    },
    "qa": {
      "description": "{file:./agents/qa.md}",
      "mode": "all",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 30,
      "repeat_penalty": 1.0,
      "tools": {
        "angular-cli": true,
        "serena": true
      }
    }
  }
}
