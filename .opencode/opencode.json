{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "angular-cli": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@angular/cli", "mcp"]
    }
  },
  "agent": {
    "planner": {
      "description": "{file:./agents/planner.md}",
      "color": "#FF0000",
      "mode": "primary",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 80,
      "repeat_penalty": 1.0,
      "task": {
        "developer": "deny",
        "reviewer": "deny"
      },
      "permission": {
        "skill": "allow",
        "edit": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        },
        "write": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        }
      }
    },
    "manager": {
      "description": "{file:./agents/manager.md}",
      "color": "#00FF00",
      "mode": "primary",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 40,
      "repeat_penalty": 1.0,
      "task": {
        "developer": "allow",
        "reviewer": "allow"
      }
    },
    "specialist": {
      "description": "{file:./agents/specialist.md}",
      "mode": "primary",
      "color": "#0000FF",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 40,
      "repeat_penalty": 1.0
    },
    "developer": {
      "description": "{file:./agents/developer.md}",
      "mode": "subagent",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 40,
      "repeat_penalty": 1.0,
      "permission": {
        "skill": "allow"
      }
    },
    "refactoring": {
      "description": "{file:./agents/refactoring.md}",
      "mode": "subagent",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 40,
      "repeat_penalty": 1.0
    },
    "reviewer": {
      "description": "{file:./agents/reviewer.md}",
      "mode": "subagent",
      "temperature": 1.0,
      "top_p": 0.95,
      "min_p": 0.01,
      "top_k": 40,
      "steps": 40,
      "repeat_penalty": 1.0,
      "permission": {
        "edit": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        },
        "write": {
          "*": "deny",
          "*\\specifications\\*": "allow",
          "*/specifications/*": "allow"
        }
      }
    }
  }
}
