{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig*.json",
        "!**/.turbo/**",
        "!e2e/**"
      ],
      "outputs": [
        "../../dist/game-board/**",
        "../../dist/game-board-ui/**",
        "../../dist/dream-game/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.spec.ts",
        "tsconfig*.json",
        "!**/.turbo/**"
      ],
      "outputs": ["../../coverage/**"]
    },
    "api-extractor": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "**/api-extractor.json",
        "tsconfig.api.json"
      ],
      "outputs": ["../../dist/types/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "e2e/**",
        "!**/.turbo/**",
        "!e2e/test-results/**",
        "!e2e/playwright-report/**"
      ],
      "outputs": ["e2e/test-results/**", "e2e/playwright-report/**"]
    },
    "init-game": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**"],
      "outputs": ["out-tsc/**"]
    }
  }
}
