{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "!**/.turbo/**"],
      "outputs": [
        "../../dist/game-board/**",
        "../../dist/game-board-ui/**",
        "../../dist/shared-ui/**",
        "../../dist/dream-game/**",
        "../../dist/shared-ui-sandbox/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.spec.ts",
        "tsconfig*.json",
        "!**/.turbo/**"
      ],
      "outputs": ["../../coverage/**"]
    },
    "api-extractor": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "**/api-extractor.json",
        "tsconfig.api.json"
      ],
      "outputs": ["../../dist/types/**"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "*.e2e.ts",
        "!**/.turbo/**",
        "!test-results/**",
        "!playwright-report/**"
      ],
      "outputs": ["test-results/**"]
    },
    "init-game": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**"],
      "outputs": ["out-tsc/**"]
    },
    "generate-items": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**"],
      "outputs": ["out-tsc/**"]
    }
  }
}
